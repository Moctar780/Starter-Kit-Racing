{
  "name": "starter-kit-racing",
  "version": "1.0.0",
  "description": "A JavaScript/Three.js port of [Kenney's Starter Kit Racing](https://github.com/KenneyNL/Starter-Kit-Racing).",
  "scripts": {
    "start": "serve . --listen tcp://0.0.0.0:${PORT:-8080} --no-port-switching",
    "test": "echo \"Error: no test specified\" && exit 1",
    "android:assemble": "cd android && ./gradlew assembleDebug",
    "android:assemble:release": "cd android && ./gradlew assembleRelease",
    "android:install": "cd android && ./gradlew installDebug",
    "android:install:release": "cd android && ./gradlew installRelease"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdoob/Starter-Kit-Racing.git"
  },
  "keywords": [],
