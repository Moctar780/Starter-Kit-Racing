  },
  "homepage": "https://github.com/mrdoob/Starter-Kit-Racing#readme",
  "dependencies": {
    "blockly": "^13.1.0",
    "crashcat": "^0.0.3",
    "serve": "^14.2.6",
    "three": "^0.185.1"
  }
}
